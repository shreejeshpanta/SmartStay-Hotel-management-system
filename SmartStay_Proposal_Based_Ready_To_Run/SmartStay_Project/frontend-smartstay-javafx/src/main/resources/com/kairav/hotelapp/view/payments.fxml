<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.kairav.hotelapp.controller.PaymentController"
      style="-fx-background-color: #f4f6f8;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- Header -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label text="Payment Management"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
            <Label text="Manage customer payments, paid amount, remaining balance and payment status."
                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
        </VBox>

        <Pane HBox.hgrow="ALWAYS"/>

        <Button text="Refresh"
                onAction="#refresh"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 16 9 16; -fx-background-radius: 8;"/>
    </HBox>

    <!-- Payment Form -->
    <VBox spacing="12"
          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">

        <Label text="Add Payment"
               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <ComboBox fx:id="bookingBox"
                      promptText="Select Booking"
                      prefWidth="280"/>

            <ComboBox fx:id="methodBox"
                      promptText="Payment Method"
                      prefWidth="180"/>

            <TextField fx:id="paidAmount"
                       promptText="Paid Amount"
                       prefWidth="160"/>

            <Button text="Pay"
                    onAction="#pay"
                    style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18 9 18; -fx-background-radius: 8;"/>
        </HBox>
    </VBox>

    <!-- Payment Table -->
    <VBox spacing="10"
          VBox.vgrow="ALWAYS"
          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">

        <Label text="Payment Records"
               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="70"/>
                <TableColumn fx:id="methodCol" text="Method" prefWidth="150"/>
                <TableColumn fx:id="totalCol" text="Total" prefWidth="130"/>
                <TableColumn fx:id="paidCol" text="Paid" prefWidth="130"/>
                <TableColumn fx:id="remainingCol" text="Remaining" prefWidth="150"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="130"/>
            </columns>
        </TableView>

    </VBox>

</VBox>