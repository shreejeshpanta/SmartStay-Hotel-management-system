<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.kairav.hotelapp.controller.BookingController"
      style="-fx-background-color: #f4f6f8;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- Header -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label text="Booking Management"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

            <Label text="Create room bookings, manage check-in, check-out, cancellation and booking records."
                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
        </VBox>

        <Pane HBox.hgrow="ALWAYS"/>

        <Button text="Refresh"
                onAction="#refresh"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 16 9 16; -fx-background-radius: 8;"/>
    </HBox>

    <!-- Booking Form -->
    <VBox spacing="12"
          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">

        <Label text="Booking Details"
               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

        <GridPane hgap="10" vgap="10">

            <ComboBox fx:id="customerBox"
                      promptText="Select Customer"
                      prefWidth="240"
                      GridPane.rowIndex="0"
                      GridPane.columnIndex="0"/>

            <ComboBox fx:id="roomBox"
                      promptText="Select Available Room"
                      prefWidth="240"
                      GridPane.rowIndex="0"
                      GridPane.columnIndex="1"/>

            <DatePicker fx:id="checkIn"
                        promptText="Check In Date"
                        prefWidth="180"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="2"/>

            <DatePicker fx:id="checkOut"
                        promptText="Check Out Date"
                        prefWidth="180"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="0"/>

            <TextField fx:id="guests"
                       promptText="Guests"
                       prefWidth="180"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>

            <TextField fx:id="advance"
                       promptText="Advance Payment"
                       prefWidth="180"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="2"/>

            <TextArea fx:id="specialRequest"
                      promptText="Special Request"
                      prefRowCount="2"
                      prefWidth="650"
                      GridPane.rowIndex="2"
                      GridPane.columnIndex="0"
                      GridPane.columnSpan="3"/>

        </GridPane>

        <HBox spacing="10">
            <Button text="Book Room"
                    onAction="#book"
                    style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18 9 18; -fx-background-radius: 8;"/>

            <Button text="Check In"
                    onAction="#checkInAction"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18 9 18; -fx-background-radius: 8;"/>

            <Button text="Check Out"
                    onAction="#checkOutAction"
                    style="-fx-background-color: #7c3aed; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18 9 18; -fx-background-radius: 8;"/>

            <Button text="Cancel"
                    onAction="#cancel"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18 9 18; -fx-background-radius: 8;"/>

            <Button text="Clear"
                    onAction="#clear"
                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18 9 18; -fx-background-radius: 8;"/>
        </HBox>

    </VBox>

    <!-- Booking Table -->
    <VBox spacing="10"
          VBox.vgrow="ALWAYS"
          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">

        <Label text="Booking Records"
               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="70"/>
                <TableColumn fx:id="customerCol" text="Customer" prefWidth="220"/>
                <TableColumn fx:id="roomCol" text="Room" prefWidth="160"/>
                <TableColumn fx:id="statusCol" text="Status" prefWidth="150"/>
                <TableColumn fx:id="totalCol" text="Total" prefWidth="140"/>
                <TableColumn fx:id="remainingCol" text="Remaining" prefWidth="150"/>
            </columns>
        </TableView>

    </VBox>

</VBox>