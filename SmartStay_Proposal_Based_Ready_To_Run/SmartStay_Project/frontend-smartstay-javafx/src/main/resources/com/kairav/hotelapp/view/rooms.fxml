<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kairav.hotelapp.controller.RoomController">

    <padding>
        <Insets bottom="15" left="15" right="15" top="15" />
    </padding>
   <HBox alignment="CENTER" prefHeight="54.0" prefWidth="635.0" style="-fx-background-color: #8080ff;">
      <children>
         <Label text="Room Management" textFill="#f2f2f2">
            <font>
               <Font name="System Bold" size="19.0" />
            </font>
         </Label>
      </children>
   </HBox>

    <GridPane hgap="8" styleClass="form-box" vgap="8">
        <TextField fx:id="roomNumber" promptText="Room No" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="roomType" promptText="Type" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <TextField fx:id="bedType" promptText="Bed" GridPane.columnIndex="2" GridPane.rowIndex="0" />

        <TextField fx:id="capacity" promptText="Capacity" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="floorNumber" promptText="Floor" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <TextField fx:id="price" promptText="Price/Night" GridPane.columnIndex="2" GridPane.rowIndex="1" />

        <ComboBox fx:id="status" promptText="Status" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextArea fx:id="description" prefRowCount="2" promptText="Description" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2" />
      <columnConstraints>
         <ColumnConstraints />
         <ColumnConstraints />
         <ColumnConstraints />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
    </GridPane>

    <HBox spacing="8">
        <Button onAction="#add" styleClass="primary" text="Add" />
        <Button onAction="#update" text="Update" />
        <Button onAction="#delete" styleClass="danger" text="Delete" />
        <Button onAction="#clear" text="Clear" />
        <Button onAction="#refresh" text="Refresh" />
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idCol" text="ID" />
            <TableColumn fx:id="noCol" text="Room No" />
            <TableColumn fx:id="typeCol" text="Type" />
            <TableColumn fx:id="statusCol" text="Status" />
            <TableColumn fx:id="priceCol" text="Price" />
        </columns>
    </TableView>

</VBox>
