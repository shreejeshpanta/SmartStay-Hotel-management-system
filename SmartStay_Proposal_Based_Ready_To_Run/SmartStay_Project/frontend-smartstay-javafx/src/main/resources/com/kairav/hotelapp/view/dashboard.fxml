<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.kairav.hotelapp.controller.DashboardController">

    <content>
        <VBox spacing="20" style="-fx-background-color: #f4f6f8;">

            <padding>
                <Insets top="25" right="25" bottom="25" left="25"/>
            </padding>

            <!-- Header -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="Smart Stay Dashboard"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1f2937;"/>
                    <Label text="Hotel overview, room status, bookings and revenue summary"
                           style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                </VBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <Button text="Refresh"
                        onAction="#refresh"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 18 10 18; -fx-background-radius: 8;"/>
            </HBox>

            <Separator/>

            <!-- Room Summary Section -->
            <Label text="Room Summary"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

            <GridPane hgap="15" vgap="15">

                <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="0"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">
                    <Label text="Total Rooms" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="totalRooms" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                    <Label text="All rooms registered" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                </VBox>

                <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">
                    <Label text="Available Rooms" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="availableRooms" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                    <Label text="Ready for booking" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                </VBox>

                <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="2"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">
                    <Label text="Booked Rooms" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="bookedRooms" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #f59e0b;"/>
                    <Label text="Reserved rooms" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                </VBox>

                <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="3"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">
                    <Label text="Occupied Rooms" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="occupiedRooms" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                    <Label text="Currently in use" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                </VBox>

            </GridPane>

            <!-- Business Summary Section -->
            <Label text="Business Summary"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

            <GridPane hgap="15" vgap="15">

                <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="0"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">
                    <Label text="Customers" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="totalCustomers" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
                    <Label text="Registered guests" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                </VBox>

                <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">
                    <Label text="Bookings" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="totalBookings" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #7c3aed;"/>
                    <Label text="Total reservations" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                </VBox>

                <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="2"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">
                    <Label text="Staff" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="totalStaff" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #0891b2;"/>
                    <Label text="Hotel employees" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                </VBox>

            </GridPane>

            <!-- Revenue Section -->
            <Label text="Revenue Summary"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

            <GridPane hgap="15" vgap="15">

                <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="0"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">
                    <Label text="Today Revenue" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="todayRevenue" text="Rs. 0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #059669;"/>
                    <Label text="Revenue generated today" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                </VBox>

                <VBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1"
                      style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">
                    <Label text="Month Revenue" style="-fx-font-size: 14px; -fx-text-fill: #6b7280;"/>
                    <Label fx:id="monthRevenue" text="Rs. 0" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #0f766e;"/>
                    <Label text="Revenue generated this month" style="-fx-font-size: 12px; -fx-text-fill: #9ca3af;"/>
                </VBox>

            </GridPane>

        </VBox>
    </content>
</ScrollPane>