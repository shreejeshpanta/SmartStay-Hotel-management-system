<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.kairav.hotelapp.controller.CustomerController"
      style="-fx-background-color: #f4f6f8;">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- Header -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <VBox spacing="4">
            <Label text="Customer Management"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

            <Label text="Manage guest information, contact details, identity records and emergency contact."
                   style="-fx-font-size: 13px; -fx-text-fill: #6b7280;"/>
        </VBox>

        <Pane HBox.hgrow="ALWAYS"/>

        <Button text="Refresh"
                onAction="#refresh"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 16 9 16; -fx-background-radius: 8;"/>
    </HBox>

    <!-- Customer Form -->
    <VBox spacing="12"
          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">

        <Label text="Customer Details"
               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

        <GridPane hgap="10" vgap="10">

            <TextField fx:id="firstName"
                       promptText="First Name"
                       prefWidth="180"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

            <TextField fx:id="lastName"
                       promptText="Last Name"
                       prefWidth="180"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>

            <TextField fx:id="gender"
                       promptText="Gender"
                       prefWidth="150"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="2"/>

            <TextField fx:id="phone"
                       promptText="Phone"
                       prefWidth="180"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

            <TextField fx:id="email"
                       promptText="Email"
                       prefWidth="220"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="1"/>

            <TextField fx:id="address"
                       promptText="Address"
                       prefWidth="220"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="2"/>

            <TextField fx:id="nationality"
                       promptText="Nationality"
                       prefWidth="180"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

            <TextField fx:id="idType"
                       promptText="ID Type"
                       prefWidth="180"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="1"/>

            <TextField fx:id="idNumber"
                       promptText="ID Number"
                       prefWidth="220"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="2"/>

            <TextField fx:id="emergencyContact"
                       promptText="Emergency Contact"
                       prefWidth="220"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

        </GridPane>

        <HBox spacing="10">
            <Button text="Add"
                    onAction="#add"
                    style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18 9 18; -fx-background-radius: 8;"/>

            <Button text="Update"
                    onAction="#update"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18 9 18; -fx-background-radius: 8;"/>

            <Button text="Delete"
                    onAction="#delete"
                    style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18 9 18; -fx-background-radius: 8;"/>

            <Button text="Clear"
                    onAction="#clear"
                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 9 18 9 18; -fx-background-radius: 8;"/>
        </HBox>

    </VBox>

    <!-- Customer Table -->
    <VBox spacing="10"
          VBox.vgrow="ALWAYS"
          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.10), 8, 0, 0, 3);">

        <Label text="Customer Records"
               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>

        <TableView fx:id="table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idCol" text="ID" prefWidth="70"/>
                <TableColumn fx:id="firstCol" text="First Name" prefWidth="160"/>
                <TableColumn fx:id="lastCol" text="Last Name" prefWidth="160"/>
                <TableColumn fx:id="phoneCol" text="Phone" prefWidth="160"/>
                <TableColumn fx:id="emailCol" text="Email" prefWidth="220"/>
            </columns>
        </TableView>

    </VBox>

</VBox>